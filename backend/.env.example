# Copy values into your hosting provider's environment settings. Do not commit real secrets.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave DATABASE_URL blank to use local SQLite. For PostgreSQL or MySQL,
# set DATABASE_URL in the hosting provider. Do not replace the current live
# URL until the old database has been backed up and the MySQL copy verified.
DATABASE_URL=
# Optional path to a CA certificate when your MySQL provider requires TLS.
MYSQL_SSL_CA=

# Appointment email is optional for local development. Configure SMTP in deployment.
APPOINTMENT_NOTIFICATION_EMAIL=clinicsirjana@gmail.com
DEFAULT_FROM_EMAIL=clinicsirjana@gmail.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=clinicsirjana@gmail.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# Railway Trial/Hobby blocks SMTP. Use Resend's HTTPS API instead:
RESEND_API_KEY=
RESEND_FROM_EMAIL=
