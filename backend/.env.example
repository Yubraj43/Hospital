# Copy values into your hosting provider's environment settings. Do not commit real secrets.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave DB_NAME blank to use local SQLite. For deployed use, configure PostgreSQL.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Appointment email is optional for local development. Configure SMTP in deployment.
APPOINTMENT_NOTIFICATION_EMAIL=clinicsirjana@gmail.com
DEFAULT_FROM_EMAIL=clinicsirjana@gmail.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=clinicsirjana@gmail.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
