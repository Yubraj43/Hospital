# Copy values into your hosting provider's environment settings. Do not commit real secrets.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave DATABASE_URL blank to use local SQLite. For local MySQL, use a URL like:
# mysql://hospital_app:replace-with-local-password@127.0.0.1:3306/hospital_app?charset=utf8mb4
# For deployment, use the URL supplied by your hosting provider. Do not replace
# a live database URL until the old database has been backed up and verified.
DATABASE_URL=
# Railway MySQL services can use these injected variables instead of
# DATABASE_URL. Do not commit real values.
MYSQLHOST=
MYSQLPORT=3306
MYSQLUSER=
MYSQLPASSWORD=
MYSQLDATABASE=
# Optional path to a CA certificate when your MySQL provider requires TLS.
MYSQL_SSL_CA=

# Appointment email is optional for local development. Configure SMTP in deployment.
APPOINTMENT_NOTIFICATION_EMAIL=clinicsirjana@gmail.com
DEFAULT_FROM_EMAIL=clinicsirjana@gmail.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=clinicsirjana@gmail.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# Railway Trial/Hobby blocks SMTP. Use Resend's HTTPS API instead:
RESEND_API_KEY=
RESEND_FROM_EMAIL=
